# Copia questo file in ".env" (nella radice del progetto, NON committarlo) e compila i valori.
# Docker Compose legge automaticamente ".env".

# --- Database (container MySQL) ---
DB_ROOT_PASSWORD=change_me_root_password
DB_NAME=omi
DB_USER=balloi
DB_PASSWORD=change_me_db_password

# --- Backend ---
NODE_ENV=production
# Genera con: openssl rand -hex 64
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d
# Origine con cui apri l'app nel browser (deve coincidere con WEB_PORT)
CORS_ORIGINS=http://localhost:8080
COOKIE_SAMESITE=lax

# Account admin creato al primo avvio (se vuoti il seed viene saltato). Password: minimo 12 caratteri.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_NOME=Admin

# --- Frontend ---
# Porta pubblicata sul tuo computer
WEB_PORT=8080
